{
  "name": "free-for-charity",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/fetch-events.mjs",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "preview": "pnpm exec serve out -l 3000",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-links": "node scripts/check-links.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "check:drift": "node scripts/check-drift.mjs",
    "check:site-config": "node scripts/check-site-config.mjs",
    "check:rebrand": "node scripts/rebrand-check.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:assets": "node scripts/check-asset-origins.mjs",
    "smoke": "node scripts/smoke-check.mjs",
    "audit:high": "pnpm audit --prod --audit-level high",
    "prepare": "husky",
    "test:smoke": "playwright test --config playwright.smoke.config.ts"
  },
  "dependencies": {
    "next": "^16.3.6",
    "postcss": "^8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "swiper": "^14.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@axe-core/react": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.3.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "linkinator": "^8.1.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.1",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.15.2",
      "uuid": ">=11.1.1",
      "picomatch": ">=4.0.4",
      "tmp": "^0.2.6",
      "sharp": "^0.35.4",
      "browserslist": "^4.28.7",
      "nanoid": "^3.3.18",
      "postcss": "$postcss"
    }
  }
}
